# =============================================
# DATABASE — PostgreSQL (required)
# =============================================
# Supported providers: Neon, Supabase, Railway, Render, local Docker
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:password@localhost:5432/interntrack?schema=public

# =============================================
# AUTHENTICATION (required in production)
# =============================================
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-very-long-random-secret-here-replace-this

# =============================================
# CORS - only needed for a SEPARATE frontend origin
# =============================================
# This app is same-origin by default (frontend + API share one domain, in both
# dev and production), so same-origin requests are always allowed automatically
# and you do NOT need to set this for a normal setup.
# Only set this if you're running the frontend on a different origin than the
# API (e.g. a standalone `vite dev` on its own port, or a separate frontend
# deployment). Comma-separated list of extra allowed origins.
# CORS_ORIGIN=https://my-separate-frontend.example.com

# =============================================
# AI FEATURES — Google Gemini (optional)
# =============================================
# Get your key at: https://aistudio.google.com/app/apikey
# AI features gracefully fall back to high-quality static responses if key is absent.
GEMINI_API_KEY=your-gemini-api-key-here
